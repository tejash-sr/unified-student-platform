# ==============================================================================
# UNIFIED STUDENT PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your actual values
# ==============================================================================

# APP CONFIGURATION
APP_NAME=Unified Student Platform
DEBUG=False
ENVIRONMENT=development

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/student_platform
# For SQLite (development only):
# DATABASE_URL=sqlite:///./student_platform.db

# SECURITY
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI/LLM SERVICES
# Groq API (FREE)
GROQ_API_KEY=your_groq_api_key_here
# Get from: https://console.groq.com

# OpenAI (Optional, for advanced features)
OPENAI_API_KEY=your_openai_api_key_here

# EMAIL & NOTIFICATIONS
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@studentplatform.com
# SendGrid free tier: 100 emails/day

# REDIS (for caching, optional)
REDIS_URL=redis://localhost:6379/0

# ANALYTICS
PLAUSIBLE_DOMAIN=studentplatform.local

# N8N WEBHOOK (for automation triggers)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/student-events

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# DATABASE SETTINGS
DATABASE_ECHO=False  # Set to True to log all SQL queries

# PAGINATION
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# LOAN SETTINGS (in INR)
MIN_LOAN_AMOUNT=100000
MAX_LOAN_AMOUNT=5000000
DEFAULT_INTEREST_RATE=8.5
DEFAULT_TENURE_MONTHS=180

# RECOMMENDATION ENGINE
MIN_USER_INTERACTIONS_FOR_RECOMMENDATION=5
TOP_N_RECOMMENDATIONS=10
